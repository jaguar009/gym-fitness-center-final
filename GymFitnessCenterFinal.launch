<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.eclipse.jdt.launching.localJavaApplication">
    <stringAttribute key="org.eclipse.jdt.launching.PROJECT_ATTR" value="gym-fitness-center-final"/>
    <stringAttribute key="org.eclipse.jdt.launching.MAIN_TYPE" value="pe.cibertec.gym.GymFitnessCenterApplication"/>
    <stringAttribute key="org.eclipse.jdt.launching.VM_ARGUMENTS" value="-Djava.library.path=&quot;${workspace_loc:/gym-fitness-center-final/native/windows-x64}&quot;"/>
    <stringAttribute key="org.eclipse.jdt.launching.PROGRAM_ARGUMENTS" value="--spring.profiles.active=local-windows"/>
    <stringAttribute key="org.eclipse.jdt.launching.WORKING_DIRECTORY" value="${workspace_loc:/gym-fitness-center-final}"/>
</launchConfiguration>
